# SSGA Frontend environment variables
# Copy to .env and adjust for your environment

# Backend API base URL (used by api.js via relative /api path in dev)
VITE_API_BASE_URL=http://localhost:8080/api

# Demo account password pre-fill on the login page.
# Must match the `-v demo_password='...'` value used when seeding demo users:
#   psql -v demo_password='123123' -f database/seed_demo_users.sql
VITE_DEMO_PASSWORD=123123
